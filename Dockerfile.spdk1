# syntax = docker/dockerfile:1.4

ARG DNF_OPTS="\
  --nobest \
  --nodocs \
  --setopt=install_weak_deps=0 \
  --setopt=keepcache=1 \
  --setopt=cachedir=/var/cache/dnf \
"

ARG ACCEL_CONFIG_SRC="/accel-config"

#------------------------------------------------------------------------------

FROM registry.redhat.io/ubi10/ubi:latest AS build

ARG SPDK_VERSION \
    SPDK_CEPH_VERSION \
    SPDK_PKGDEP_ARGS \
    SPDK_CONFIGURE_ARGS \
    SPDK_TARGET_ARCH \
    SPDK_MAKEFLAGS \
    DNF_OPTS \
    ACCEL_CONFIG_SRC

WORKDIR /src
COPY . .

COPY ceph.repo /etc/yum.repos.d/ceph.repo
COPY ceph-pkgset /tmp/ceph-pkgset

COPY spdk/ /src/
COPY spdk/scripts/ /src/scripts/
COPY spdk/rpmbuild/ /src/rpmbuild/
RUN ls -l /src/rpmbuild/
RUN ls -l /src/configure && ls -l /src/rpmbuild/rpm.sh

RUN --mount=type=secret,id=org-id \
    --mount=type=secret,id=activation-key \
    set -eux \
    && subscription-manager register \
        --activationkey=$(cat /run/secrets/activation-key) \
        --org=$(cat /run/secrets/org-id) \
    && subscription-manager repos \
        --enable=rhel-10-for-x86_64-baseos-rpms \
        --enable=rhel-10-for-x86_64-appstream-rpms \
        --enable=codeready-builder-for-rhel-10-x86_64-rpms

# Install build dependencies
RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=cache,target=/var/lib/dnf \
    dnf install -y $DNF_OPTS \
        rpm-build git-core \
        dnf-plugins-core \
    && dnf install -y \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm \
    && dnf groupinstall -y "Development Tools" || true \
    && dnf install -y \
        autoconf automake libtool pkgconf rpmdevtools \
        which asciidoc xmlto \
        libuuid-devel json-c-devel zlib-devel openssl-devel

# Build accel-config
RUN git clone https://github.com/intel/idxd-config.git $ACCEL_CONFIG_SRC \
    && cd $ACCEL_CONFIG_SRC \
    && ./autogen.sh \
    && ./configure --prefix=/usr --libdir=/usr/lib64 \
    \
    && rpmdev-setuptree \
    \
    && make rhel/accfg.spec \
    && ./rpmbuild.sh

# Install accel locally (safe)
RUN rpm -ivh /root/rpmbuild/RPMS/$(uname -m)/accel-config*.rpm

# Build SPDK RPMs
RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=cache,target=/var/lib/dnf \
    set -euxo pipefail \
    \
    && dnf install -y \
        gcc gcc-c++ make cmake \
        glibc-devel \
        \
        rpm-build rpmdevtools \
        git-core \
        dnf-plugins-core \
        pkgconf-pkg-config \
        autoconf automake libtool \
        which \
        \
        asciidoc xmlto \
        \
        libuuid-devel json-c-devel zlib-devel openssl-devel libaio-devel \
        \
        numactl numactl-devel \
        \
        libpcap libpcap-devel \
        libbsd-devel \
        jansson-devel \
        libarchive-devel \
        \
        procps-ng \
        \
        meson ninja-build \
        python3 python3-devel python3-pip python3-pyelftools \
        \
        librados-devel librbd-devel \
        \
        fuse3 fuse3-devel \
        \
        nasm isa-l-devel \
        \
        ncurses ncurses-devel readline-devel \
        \
        # DPDK build stability
        libfdt-devel elfutils-libelf-devel \
        \
        --setopt=install_weak_deps=0 \
    \
    && export PATH=/usr/bin:/usr/local/bin:$PATH \
    \
    # Build SPDK RPM
    && DEPS="no" \
       SPDK_VERSION=${SPDK_VERSION} \
       MAKEFLAGS=$SPDK_MAKEFLAGS \
       rpmbuild/rpm.sh $SPDK_CONFIGURE_ARGS --target-arch="${SPDK_TARGET_ARCH}"

# Build bdevperf binary
RUN make -C ./examples/bdev/bdevperf

#------------------------------------------------------------------------------
FROM registry.redhat.io/ubi10/ubi:latest AS spdk

RUN set -eux; \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm; \
    dnf install -y \
        pkgconf-pkg-config libaio numactl libuuid json-c zlib openssl \
        libbsd libarchive jansson \
        cpio grep fuse3-libs \
    && dnf clean all

RUN mkdir -p /opt/spdk/lib /opt/spdk/bin

COPY --from=build /usr/lib64/libnbd.so.0* /opt/spdk/lib/
COPY --from=build /usr/lib64/librdmacm.so.1* /opt/spdk/lib/
COPY --from=build /usr/lib64/libibverbs.so.1* /opt/spdk/lib/
COPY --from=build /usr/lib64/libibumad.so.3* /opt/spdk/lib/
COPY --from=build /usr/lib64/librbd.so.1* /opt/spdk/lib/

COPY --from=build /root/rpmbuild/RPMS /tmp/accel-rpms/
COPY --from=build /root/rpmbuild/rpm /tmp/spdk-rpms/

RUN set -euxo pipefail; \
    mkdir -p /tmp/extract; cd /tmp/extract; \
    find /tmp/accel-rpms /tmp/spdk-rpms -name "*.rpm" \
        | grep -vE "debuginfo|devel|debugsource" \
        | xargs -I {} sh -c 'rpm2cpio {} | cpio -idmv'; \
    \
    if [ -d usr/local/bin ]; then cp -rn usr/local/bin/* /usr/local/bin/; fi; \
    if [ -d usr/lib64 ]; then cp -rn usr/lib64/* /opt/spdk/lib/; fi; \
    if [ -d usr/local/lib/python3.12/site-packages ]; then \
        mkdir -p /usr/local/lib/python3.12/site-packages; \
        cp -rn usr/local/lib/python3.12/site-packages/* /usr/local/lib/python3.12/site-packages/; \
    fi; \
    \
    cd /; rm -rf /tmp/extract /tmp/accel-rpms /tmp/spdk-rpms

RUN echo '#!/bin/bash' > /usr/local/bin/nvmf_tgt_wrapper && \
    echo 'export LD_LIBRARY_PATH=/opt/spdk/lib:$LD_LIBRARY_PATH' >> /usr/local/bin/nvmf_tgt_wrapper && \
    echo 'exec /usr/local/bin/nvmf_tgt "$@"' >> /usr/local/bin/nvmf_tgt_wrapper && \
    chmod +x /usr/local/bin/nvmf_tgt_wrapper

ENV PATH="/usr/local/bin:${PATH}"

RUN rpm -qa > /dev/null && echo "SUCCESS: System RPM tool is healthy"

ENTRYPOINT ["/usr/local/bin/nvmf_tgt_wrapper"]
CMD ["-u", "-r", "/var/tmp/spdk.sock"]

#------------------------------------------------------------------------------
FROM spdk AS bdevperf

ENV BDEVPERF_TEST_DURATION="90" \
    BDEVPERF_SOCKET="/tmp/bdevperf.sock" \
    BDEVPERF_IO_QUEUE="128" \
    BDEVPERF_IO_BS="4096" \
    BDEVPERF_IO_TYPE="verify" \
    BDEVPERF_CORE_LIST="0"

COPY --from=build /src/build/examples/bdevperf /usr/local/bin/bdevperf
COPY --from=build /src/examples/bdev/bdevperf/bdevperf.py /usr/libexec/spdk/scripts/bdevperf.py

RUN chmod +x /usr/local/bin/bdevperf

ENTRYPOINT ["sh", "-c", "LD_LIBRARY_PATH=/opt/spdk/lib:$LD_LIBRARY_PATH /usr/local/bin/bdevperf \"$@\"", "--"]
